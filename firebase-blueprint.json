{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information including nickname, anthropometrics and nutritional targets",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique identifier of the user matching auth.uid" },
        "displayName": { "type": "string", "maxLength": 100, "description": "Display name or nickname" },
        "email": { "type": "string", "maxLength": 150, "description": "User email address" },
        "photoURL": { "type": "string", "maxLength": 500, "description": "User avatar URL" },
        "age": { "type": "number", "description": "Age in years (11-99)" },
        "weightKg": { "type": "number", "description": "Weight in kilograms" },
        "heightCm": { "type": "number", "description": "Height in centimeters" },
        "gender": { "type": "string", "enum": ["male", "female", "other"], "description": "User biological gender for basal metabolic rate" },
        "activityLevel": { "type": "string", "description": "Physical activity level" },
        "personalGoal": { "type": "string", "description": "Nutritional goal description" },
        "calculatedBmi": { "type": "number", "description": "Calculated BMI value" },
        "estimatedTdee": { "type": "number", "description": "Estimated daily caloric requirement" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp when profile was created" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp when profile was last updated" }
      },
      "required": ["uid", "displayName", "email", "createdAt", "updatedAt"]
    },
    "FoodLogItem": {
      "title": "FoodLogItem",
      "description": "A food consumption record logged by the student/user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log item identifier" },
        "userId": { "type": "string", "description": "Owner user UID" },
        "date": { "type": "string", "description": "Date of consumption in YYYY-MM-DD" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"], "description": "Meal category" },
        "foodName": { "type": "string", "maxLength": 150, "description": "Name of the food item" },
        "consumedAmount": { "type": "number", "description": "Amount consumed" },
        "unit": { "type": "string", "maxLength": 30, "description": "Unit of measurement" },
        "caloriesKcal": { "type": "number", "description": "Total calories in kcal" },
        "freeSugarGrams": { "type": "number", "description": "Free sugar in grams" },
        "sodiumMg": { "type": "number", "description": "Sodium in milligrams" },
        "proteinGrams": { "type": "number", "description": "Protein in grams" },
        "fatGrams": { "type": "number", "description": "Fat in grams" },
        "carbsGrams": { "type": "number", "description": "Carbohydrates in grams" },
        "source": { "type": "string", "enum": ["scanned_label", "manual_input", "preset_vietnamese_food"], "description": "Source of data" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["id", "userId", "date", "mealType", "foodName", "caloriesKcal", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection containing personal details"
    },
    "/users/{userId}/foodLogs/{logId}": {
      "schema": "FoodLogItem",
      "description": "User personal food consumption log records"
    }
  }
}
