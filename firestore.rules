rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 150 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('age' in data) || (data.age is number && data.age >= 5 && data.age <= 120)) &&
             (!('weightKg' in data) || (data.weightKg is number && data.weightKg >= 10 && data.weightKg <= 300)) &&
             (!('heightCm' in data) || (data.heightCm is number && data.heightCm >= 50 && data.heightCm <= 250)) &&
             (!('gender' in data) || (data.gender in ['male', 'female', 'other'])) &&
             (!('activityLevel' in data) || (data.activityLevel is string && data.activityLevel.size() <= 50)) &&
             (!('personalGoal' in data) || (data.personalGoal is string && data.personalGoal.size() <= 200)) &&
             (!('calculatedBmi' in data) || (data.calculatedBmi is number)) &&
             (!('estimatedTdee' in data) || (data.estimatedTdee is number));
    }

    function isValidFoodLog(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId && data.userId == request.auth.uid &&
             data.foodName is string && data.foodName.size() > 0 && data.foodName.size() <= 150 &&
             data.date is string && data.date.size() <= 20 &&
             data.mealType in ['breakfast', 'lunch', 'dinner', 'snack'] &&
             data.caloriesKcal is number && data.caloriesKcal >= 0 && data.caloriesKcal <= 10000 &&
             (!('consumedAmount' in data) || (data.consumedAmount is number && data.consumedAmount >= 0)) &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 30)) &&
             (!('freeSugarGrams' in data) || (data.freeSugarGrams is number && data.freeSugarGrams >= 0)) &&
             (!('sodiumMg' in data) || (data.sodiumMg is number && data.sodiumMg >= 0)) &&
             (!('proteinGrams' in data) || (data.proteinGrams is number && data.proteinGrams >= 0)) &&
             (!('fatGrams' in data) || (data.fatGrams is number && data.fatGrams >= 0)) &&
             (!('carbsGrams' in data) || (data.carbsGrams is number && data.carbsGrams >= 0)) &&
             (!('source' in data) || (data.source in ['scanned_label', 'manual_input', 'preset_vietnamese_food']));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /foodLogs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(logId) && isValidFoodLog(incoming(), userId) && incoming().createdAt == request.time;
        allow update: if isOwner(userId) && isValidId(logId) && isValidFoodLog(incoming(), userId) && incoming().id == existing().id && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(logId);
      }
    }
  }
}
